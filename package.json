  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"const cp=require('child_process'); process.env.NODE_ENV='production'; const r=cp.spawnSync(process.platform==='win32'?'pnpm.cmd':'pnpm',['exec','next','build','--webpack'],{stdio:'inherit',shell:true,env:process.env}); process.exit(r.status||0)\"",
